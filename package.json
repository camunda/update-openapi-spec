{
  "name": "update-openapi-spec",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:endpoint-map": "node build-endpoint-map.mjs",
    "build:version-map": "node get-version-map.mjs",
    "build:artefacts": "node build-artefacts.mjs",
    "update:operations": "npm run build:artefacts && node update-specs-operations.mjs",
    "update:properties": "npm run build:artefacts && node update-specs-properties.mjs",
    "verify:specs": "npm run build:artefacts && node verify-specs.mjs",
    "verify:specs:ci": "node verify-specs-ci.mjs",
    "verify:specs:workflow": "node verify-specs-workflow.mjs",
    "generate:workflow-matrix": "node generate-workflow-matrix.mjs"
  },
  "dependencies": {
    "camunda-schema-bundler": "^2.4.1",
    "dotenv": "^16.4.0",
    "yaml": "^2.8.3"
  }
}
